Cell[TextData[{
 "This plot represents a global portrait of the instability zones, i.e. for \
which points (\[Alpha],k) the equilibrium (0,0) is Lyapunov unstable.\nWhile \
the regions with no points are the stability zones. \n\n",
 StyleBox["The instability regions are tongues ",
  FontVariations->{"Underline"->True}],
 "(existence proved)",
 StyleBox[".",
  FontVariations->{"Underline"->True}]
}], "Text",
 CellChangeTimes->{{3.9648783916106586`*^9, 3.964878446770405*^9}, {
  3.9648784794871197`*^9, 3.9648785277037716`*^9}, {3.96487856777104*^9, 
  3.9648785955109386`*^9}, {3.964884900409849*^9, 3.964884905194212*^9}, {
  3.965016915126875*^9, 3.96501691662319*^9}, {3.9666701802332096`*^9, 
  3.96667026066354*^9}, {3.969099762402899*^9, 3.9690997660319233`*^9}, {
  3.9691650051453247`*^9, 
  3.969165005401396*^9}},ExpressionUUID->"afb3e62e-51e4-b148-b936-\
ad6d1c3d032b"],

Cell[TextData[{
 StyleBox["Notice that for k=0",
  FontVariations->{"Underline"->True}],
 " , ",
 StyleBox["just for some specific \[Alpha] the equilibria is unstable, where \
the tongues intersect the horizontal axis . ",
  FontVariations->{"Underline"->True}],
 "\nFrom the theory we know that this can happen only ",
 StyleBox["at  |Tr|=2  iff  \[Alpha]",
  FontVariations->{"Underline"->True}],
 StyleBox[" = n/2",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 " ",
 StyleBox[", where ",
  FontVariations->{"Underline"->True}],
 StyleBox["n",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox[" is any integer ",
  FontVariations->{"Underline"->True}],
 ".\nThese points are those at ",
 StyleBox["stability boundary",
  FontVariations->{"Underline"->True}],
 ", where the ",
 StyleBox["system transitions from stability to instability regions and \
viceversa.",
  FontVariations->{"Underline"->True}],
 "\n\nI",
 StyleBox["f k=0 , more likely (0,0) is stable, but we can force \[Alpha]",
  FontVariations->{"Underline"->True}],
 StyleBox[" ,",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 StyleBox["which depends on the frequency of the external force, to make \
(0,0) unstable.\n\nAt  (k,\[Alpha])=(0, n/2) for any positive integer n,  the \
instability tongues end with a cusp point. \n",
  FontVariations->{"Underline"->True}],
 "In the following I check numerically that at every multiple of 0.5 we have \
an instability tongue:"
}], "Text",
 CellChangeTimes->{{3.9648786048019505`*^9, 3.964878616405239*^9}, {
   3.964878759924225*^9, 3.964878811245472*^9}, {3.964879378033312*^9, 
