Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"RK2", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a", ",", "k"}], "}"}], ",", "h"}], "]"}], "[", 
  RowBox[{"{", 
   RowBox[{"x", ",", "v", ",", "t"}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.9648726662257175`*^9, 3.9648726926066914`*^9}, {
  3.964872791718191*^9, 3.964872796259657*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"6afbccfb-c1f8-a54e-be95-3f53a46516e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"x", "+", 
    RowBox[{"h", " ", 
     RowBox[{"(", 
      RowBox[{"v", "+", 
       RowBox[{
        FractionBox["1", "2"], " ", "h", " ", "x", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["a", "2"]}], "+", 
          RowBox[{"k", " ", 
           RowBox[{"Cos", "[", "t", "]"}]}]}], ")"}]}]}], ")"}]}]}], ",", 
   RowBox[{"v", "+", 
    RowBox[{"h", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"h", " ", "v"}], "2"], "+", "x"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["a", "2"]}], "+", 
       RowBox[{"k", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{
          FractionBox["h", "2"], "+", "t"}], "]"}]}]}], ")"}]}]}], ",", 
   RowBox[{"h", "+", "t"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.9648726953014126`*^9, 3.9648727070355606`*^9}, 
   3.964872799108961*^9, 3.9648728309235973`*^9, 3.964872980688244*^9, 
   3.964878053205673*^9, 3.9650163774649277`*^9, 3.9666693087153034`*^9, 
   3.966670020191326*^9, 3.9690972042148056`*^9, 3.9691008561665573`*^9, 
   3.9691010230656757`*^9, 3.9691138593245335`*^9, 3.9691141027579727`*^9, 
   3.9691648533372345`*^9, 3.9691652693396683`*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"d3d2765c-aa30-1649-90ea-033958da67f0"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RK2c", "=", " ", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Alpha]k", ",", "_Real", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"xvt", ",", "_Real", ",", "1"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"xvt", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{"h", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"xvt", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", 
            RowBox[{
             FractionBox["1", "2"], " ", "h", " ", 
             RowBox[{"xvt", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", 
                SuperscriptBox[
                 RowBox[{"\[Alpha]k", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "2"]}], "+", 
               RowBox[{
                RowBox[{"\[Alpha]k", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{"xvt", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "]"}]}]}], ")"}]}]}], 
           ")"}]}]}], ",", "  ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"xvt", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "+", 
         RowBox[{"h", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"h", " ", 
              RowBox[{"xvt", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "2"], "+", 
            RowBox[{"xvt", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox[
              RowBox[{"\[Alpha]k", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "2"]}], "+", 
            RowBox[{
             RowBox[{"\[Alpha]k", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", 
             RowBox[{"Cos", "[", 
              RowBox[{
               FractionBox["h", "2"], "+", 
               RowBox[{"xvt", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], ")"}]}]}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"h", "+", 
         RowBox[{"xvt", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], "]"}]}], " ", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "RK2", " ", "already", " ", "implemented", " ", "with", " ", "vector", 
     " ", "field", " ", "XL", " ", "inside"}], ",", " ", 
    RowBox[{"faster", " ", "computations"}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.964872537765791*^9, 3.9648725388079987`*^9}, {
  3.9648725917207165`*^9, 3.9648726497917595`*^9}, {3.9648730023357944`*^9, 
  3.9648730573774796`*^9}, {3.966669339475357*^9, 3.966669345597456*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"17ba75a9-9141-564a-8b93-cf8fc1e1c4ef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"solc", "=", 
    RowBox[{"Compile", "[", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Alpha]k", ",", "_Real", ",", "1"}], "}"}], ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"xv", ",", "_Real", ",", "1"}], "}"}]}], "}"}], ",", " ", 
      "\[IndentingNewLine]", "                                        ", 
      RowBox[{"Take", "[", "     ", 
       RowBox[{
        RowBox[{"Nest", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RK2c", "[", 
            RowBox[{"\[Alpha]k", ",", 
             FractionBox[
              RowBox[{"2", "\[Pi]"}], "n"], ",", "#"}], "]"}], "&"}], ",", 
          RowBox[{"Append", "[", 
           RowBox[{"xv", ",", "0"}], "]"}], ",", "n"}], "]"}], "   ", ",", 
        " ", "2"}], "]"}]}], " ", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"#", " ", "&"}], " ", "converts", " ", "the", " ", "slot", " ", 
    "#", " ", "into", " ", "a", " ", "input", " ", "for", " ", "the", " ", 
    "function"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.96487302107806*^9, 3.9648730221857414`*^9}, {
  3.9648747990682526`*^9, 3.96487480070364*^9}, {3.964874832482361*^9, 
  3.964874899184746*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"cab4e507-99bb-8d45-8c60-56103b6e974b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PSMc", "[", 
     RowBox[{"ak_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"solc", "[", 
       RowBox[{"ak", ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "]"}], ",", 
      RowBox[{"solc", "[", 
       RowBox[{"ak", ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}]}], " ", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Period", " ", "shift", " ", "map"}], "=", 
    RowBox[{"Pointcar\[EAcute]", " ", "Map"}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9648749225681324`*^9, 3.964874980025652*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"9b445b13-d446-3c46-ad8b-6f2f736c69ef"],

Cell[TextData[{
 StyleBox["STUDY OF LYAPUNOV STABILITY WRTO (a,k) AND PLOT UNSTABLE POINTS :\n\
\n",
  FontWeight->"Bold"],
 StyleBox["We need to study the spectrum of the linearization of PSMc at \
(0,0), i.e ",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{"\[Alpha]", ",", "k"}]], "'"}], TraditionalForm]],ExpressionUUID->
  "f92a53db-d2f2-0a4a-81fa-7f9cd72b1dbd"],
 StyleBox["(0,0), made of 2 eigenvalues.\nAs noticed in the theory the \
dynamical system conserves the volume, hence the product of the two \
eigenvalues is 1, and by the Lyapunov Stability Criterium:\n|Tr(",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{"\[Alpha]", ",", "k"}]], "'"}], TraditionalForm]],ExpressionUUID->
  "291f1a4a-1dd3-7d40-969c-9735e3d6812c"],
 StyleBox["(0,0))| <= 2  if and only if (0,0) Lyapunov Stable ;\n|Tr(",
  FontWeight->"Plain"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", 
     RowBox[{"\[Alpha]", ",", "k"}]], "'"}], TraditionalForm]],ExpressionUUID->
  "34b06303-d273-0d47-85f3-29b057eaae15"],
 StyleBox["(0,0))| > 2  if and only if (0,0) Lyapunov Unstable .\n\nWe choose \
this derivation of the criterium because it doesn\[CloseCurlyQuote]t require \
to compute explicitely the eigenvalues of PSM, but it\[CloseCurlyQuote]s \
enough to compute its trace.\nThen plot unstable points.",
  FontWeight->"Plain"]
}], "Text",
 CellChangeTimes->{{3.964874989039192*^9, 3.964875025887495*^9}, {
   3.9648750812915726`*^9, 3.964875374306383*^9}, {3.964876052807907*^9, 
   3.9648760671512947`*^9}, {3.9648761388963394`*^9, 3.964876146392927*^9}, {
   3.9648762990633793`*^9, 3.9648763080229588`*^9}, 3.965016459568825*^9, {
   3.9650168105233784`*^9, 3.965016811035944*^9}, {3.9690993365429287`*^9, 
   3.9690994056239624`*^9}},ExpressionUUID->"9410675e-9f56-464d-a896-\
f7642852c235"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]kTr", "[", 
     RowBox[{"ak_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"{", "  ", 
     RowBox[{"ak", ",", "   ", 
      RowBox[{"Abs", "[", 
       RowBox[{"Tr", "[", " ", 
        RowBox[{"PSMc", "[", 
         RowBox[{"ak", ",", "n"}], "]"}], "]"}], "   ", "]"}]}], "  ", 
     "}"}]}], "  ", ";"}], "           ", 
  RowBox[{"(*", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", ",", "k"}], ")"}], ",", 
     RowBox[{"|", "Tr", "|"}]}], ")"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Rand\[Alpha]kTr", "[", 
     RowBox[{
     "n_", ",", " ", "a1_", ",", "a2_", ",", " ", "k1_", ",", " ", "k2_"}], 
     "]"}], ":=", " ", 
    RowBox[{"\[Alpha]kTr", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{"a1", ",", "a2"}], "}"}], "]"}], ",", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{"k1", ",", "k2"}], "}"}], "]"}]}], "}"}], ",", " ", "n"}], 
     " ", "]"}]}], " ", ";"}], "          ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", ",", "k"}], ")"}], ",", 
       RowBox[{"|", "Tr", "|"}]}], ")"}], " ", "with", " ", "a"}], ",", 
    RowBox[{"k", " ", "random"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox[
       RowBox[{"crit", 
        StyleBox["Tr",
         FontColor->RGBColor[1, 0, 0]]}]], "[", "eps_", "]"}], "[", "lst_", 
     "]"}], ":=", "  ", 
    RowBox[{
     RowBox[{"lst", "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}], ">", 
     RowBox[{"2", "+", "eps"}]}]}], "   ", ";"}], 
  "                                           ", 
  RowBox[{"(*", 
   RowBox[{"criterion", " ", "|", "trace", "|", " ", 
    RowBox[{">", " ", 
     RowBox[{"2", " ", "+", " ", "eps"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"UnstTr", "[", 
     RowBox[{"lst_", ",", "eps_"}], "]"}], ":=", 
    RowBox[{"Select", "[", 
     RowBox[{"lst", ",", 
      RowBox[{"critTr", "[", "eps", "]"}]}], "]"}]}], " ", ";"}], 
  "                              ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"select", " ", "those", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", ",", "k"}], ")"}], ",", 
        RowBox[{"|", "Tr", "|"}]}], ")"}], " ", "with"}], " ", "|", "Tr", "|",
      " ", 
     RowBox[{">", " ", 
      RowBox[{"2", " ", "+", " ", "eps"}]}]}], " ", ",", " ", 
    RowBox[{"i", ".", "e", ".", " ", "unstable"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PlotUnstTr", "[", 
     RowBox[{"lst_", 
      StyleBox[",",
       FontColor->GrayLevel[0]], 
      StyleBox["eps_",
       FontColor->GrayLevel[0]], 
      StyleBox[",",
       FontColor->GrayLevel[0]], 
      StyleBox[" ",
       FontColor->GrayLevel[0]], 
      StyleBox["a1_",
       FontColor->GrayLevel[0]], 
      StyleBox[",",
       FontColor->GrayLevel[0]], 
      StyleBox[" ",
       FontColor->GrayLevel[0]], 
      StyleBox["a2_",
       FontColor->GrayLevel[0]], 
      StyleBox[",",
       FontColor->GrayLevel[0]], 
      StyleBox[" ",
       FontColor->GrayLevel[0]], 
      StyleBox["k1_",
       FontColor->GrayLevel[0]], 
      StyleBox[",",
       FontColor->GrayLevel[0]], 
      StyleBox[" ",
       FontColor->GrayLevel[0]], 
      StyleBox["k2_",
       FontColor->GrayLevel[0]]}], "]"}], ":=", 
    RowBox[{"ListPlot", "[", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"UnstTr", "[", 
         RowBox[{"lst", ",", "eps"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", ",", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a1", ",", "a2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k1", ",", "k2"}], "}"}]}], "}"}]}], " ", ",", " ", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<k\>\""}], "}"}]}]}], "  ", 
     "]"}]}], "   ", ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"plot", " ", "unstable", " ", "points", " ", 
    RowBox[{"(", 
     RowBox[{"\[Alpha]", ",", "k"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9648761629043064`*^9, 3.964876163579777*^9}, {
   3.964876266743412*^9, 3.964876334858036*^9}, {3.964876368275526*^9, 
