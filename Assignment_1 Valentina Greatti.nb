Cell[TextData[{
 "The equilibria (Pi,0) is more likely unstable, but we can notice that there \
exist some (\[Alpha],k)  for which we have stability .\nBut also that the \
number of avaiable  \[Alpha]",
 StyleBox["\[CloseCurlyQuote]s ",
  FontSlant->"Italic"],
 " decreases as \[Alpha]",
 StyleBox[" ",
  FontSlant->"Italic"],
 "increases, e.g. the no-points-strip becomes even more thinner as \[Alpha]",
 StyleBox[" ",
  FontSlant->"Italic"],
 "increases."
}], "Text",
