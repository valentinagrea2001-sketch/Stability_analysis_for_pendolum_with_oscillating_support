Cell[CellGroupData[{

Cell["Stability/Unstability regions for (Pi,0) fixed point :", "Section",
 CellChangeTimes->{{3.9648810421773033`*^9, 
  3.964881084906109*^9}},ExpressionUUID->"73111bf7-e286-674c-8358-\
ed56de8261e9"],

Cell["\<\
Adapt the previous code, it changes just the orbit t-->(Pi,0,t) of the \
equilibrium , and hence the variational equation.\
\>", "Text",
 CellChangeTimes->{{3.9648810580857964`*^9, 3.9648811250343704`*^9}, {
  3.966671087480425*^9, 3.966671094170889*^9}, {3.9690999425912704`*^9, 
  3.9690999585328407`*^9}},ExpressionUUID->"b4129dd1-3d55-ac48-af68-\
eee3a91ca5de"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"XLp", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", "k_"}], "}"}], "]"}], "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "v_", ",", "t_"}], "}"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{"v", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "^", "2"}], " ", "-", " ", 
         RowBox[{"k", " ", 
          RowBox[{"Cos", "[", "t", "]"}]}]}], ")"}], " ", "x"}], " ", ",", 
      " ", "1"}], "}"}]}], " ", ";"}], "             ", 
  RowBox[{"(*", 
   RowBox[{
   "vector", " ", "field", " ", "of", " ", "variational", " ", "equation", 
    " ", "for", " ", 
    RowBox[{"(", 
     RowBox[{"Pi", ",", "0"}], ")"}], " ", "equilibria"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.964881131707281*^9, 3.964881165284424*^9}, 
   3.964881403782696*^9, {3.964881511054737*^9, 3.9648815322814045`*^9}, {
   3.9666713133321877`*^9, 3.966671314402624*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"d4f06481-e9d6-8644-b784-b2c27be1bcc6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RK2cp", "=", " ", 
    RowBox[{"Compile", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Alpha]k", ",", "_Real", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", "_Real"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"xvt", ",", "_Real", ",", "1"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"xvt", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{"h", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"xvt", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", 
            RowBox[{
             FractionBox["1", "2"], " ", "h", " ", 
             RowBox[{"xvt", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", 
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox[
                RowBox[{"\[Alpha]k", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "2"], "-", 
               RowBox[{
                RowBox[{"\[Alpha]k", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], " ", 
                RowBox[{"Cos", "[", 
                 RowBox[{"xvt", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "]"}]}]}], ")"}]}]}], 
           ")"}]}]}], ",", "  ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"xvt", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "+", 
         RowBox[{"h", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"h", " ", 
              RowBox[{"xvt", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "2"], "+", 
            RowBox[{"xvt", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"\[Alpha]k", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "2"], "-", 
            RowBox[{
             RowBox[{"\[Alpha]k", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", 
             RowBox[{"Cos", "[", 
              RowBox[{
               FractionBox["h", "2"], "+", 
               RowBox[{"xvt", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], ")"}]}]}], ",", 
        "\[IndentingNewLine]", "   ", 
        RowBox[{"h", "+", 
         RowBox[{"xvt", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], "]"}]}], " ", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"solcp", "=", 
    RowBox[{"Compile", "[", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Alpha]k", ",", "_Real", ",", "1"}], "}"}], ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"xv", ",", "_Real", ",", "1"}], "}"}]}], "}"}], ",", " ", 
      "\[IndentingNewLine]", "                                        ", 
      RowBox[{"Take", "[", "     ", 
       RowBox[{
        RowBox[{"Nest", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"RK2cp", "[", 
            RowBox[{"\[Alpha]k", ",", 
             FractionBox[
              RowBox[{"2", "\[Pi]"}], "n"], ",", "#"}], "]"}], "&"}], ",", 
          RowBox[{"Append", "[", 
           RowBox[{"xv", ",", "0"}], "]"}], ",", "n"}], "]"}], "   ", ",", 
        " ", "2"}], "]"}]}], " ", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PSMcp", "[", 
     RowBox[{"ak_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"solcp", "[", 
       RowBox[{"ak", ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "]"}], ",", 
      RowBox[{"solcp", "[", 
       RowBox[{"ak", ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}]}], " ", ";"}], 
  "                                                                           \
      ", 
  RowBox[{"(*", 
   RowBox[{"SETUP", " ", "with", " ", "Compile"}], 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9648814394296*^9, 3.964881587927082*^9}, {
  3.9650171671326313`*^9, 3.965017172774023*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"acd182fa-97d8-284f-82e6-ea6b0f71d727"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]kTrp", "[", 
     RowBox[{"ak_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"{", "  ", 
     RowBox[{"ak", ",", "   ", 
      RowBox[{"Abs", "[", 
       RowBox[{"Tr", "[", " ", 
        RowBox[{"PSMcp", "[", 
         RowBox[{"ak", ",", "n"}], "]"}], "]"}], "   ", "]"}]}], "  ", 
     "}"}]}], "  ", ";"}], "           ", 
  RowBox[{"(*", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]", ",", "k"}], ")"}], ",", 
     RowBox[{"|", "Tr", "|"}]}], ")"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Rand\[Alpha]kTrp", "[", 
     RowBox[{
     "n_", ",", " ", "a1_", ",", "a2_", ",", " ", "k1_", ",", " ", "k2_"}], 
     "]"}], ":=", " ", 
    RowBox[{"\[Alpha]kTrp", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{"a1", ",", "a2"}], "}"}], "]"}], ",", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{"k1", ",", "k2"}], "}"}], "]"}]}], "}"}], ",", " ", "n"}], 
     " ", "]"}]}], " ", ";"}], "          ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Alpha]", ",", "k"}], ")"}], ",", 
       RowBox[{"|", "Tr", "|"}]}], ")"}], " ", "with", " ", "\[Alpha]"}], ",", 
    RowBox[{"k", " ", "random"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      StyleBox[
       RowBox[{"crit", 
        StyleBox["Tr",
         FontColor->RGBColor[1, 0, 0]]}]], "[", "eps_", "]"}], "[", "lst_", 
     "]"}], ":=", "  ", 
    RowBox[{
     RowBox[{"lst", "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}], ">", 
     RowBox[{"2", "+", "eps"}]}]}], "   ", ";"}], 
  "                                           ", 
  RowBox[{"(*", 
   RowBox[{"criterion", " ", "|", "trace", "|", " ", 
    RowBox[{">", " ", 
     RowBox[{"2", " ", "+", " ", "eps"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"UnstTr", "[", 
     RowBox[{"lst_", ",", "eps_"}], "]"}], ":=", 
    RowBox[{"Select", "[", 
     RowBox[{"lst", ",", 
      RowBox[{"critTr", "[", "eps", "]"}]}], "]"}]}], " ", ";"}], 
  "                              ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"select", " ", "those", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Alpha]", ",", "k"}], ")"}], ",", 
        RowBox[{"|", "Tr", "|"}]}], ")"}], " ", "with"}], " ", "|", "Tr", "|",
      " ", 
     RowBox[{">", " ", 
      RowBox[{"2", " ", "+", " ", "eps"}]}]}], " ", ",", " ", 
    RowBox[{"i", ".", "e", ".", " ", "unstable"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PlotUnstTr", "[", 
     RowBox[{"lst_", 
      StyleBox[",",
       FontColor->GrayLevel[0]], 
      StyleBox["eps_",
       FontColor->GrayLevel[0]], 
      StyleBox[",",
       FontColor->GrayLevel[0]], 
      StyleBox[" ",
       FontColor->GrayLevel[0]], 
      StyleBox["a1_",
       FontColor->GrayLevel[0]], 
      StyleBox[",",
       FontColor->GrayLevel[0]], 
      StyleBox[" ",
