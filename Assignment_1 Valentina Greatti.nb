      StyleBox["k1_",
       FontColor->GrayLevel[0]], 
      StyleBox[",",
       FontColor->GrayLevel[0]], 
      StyleBox[" ",
       FontColor->GrayLevel[0]], 
      StyleBox["k2_",
       FontColor->GrayLevel[0]]}], "]"}], ":=", 
    RowBox[{"ListPlot", "[", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"UnstTr", "[", 
         RowBox[{"lst", ",", "eps"}], "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", ",", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a1", ",", "a2"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k1", ",", "k2"}], "}"}]}], "}"}]}], " ", ",", " ", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<k\>\""}], "}"}]}]}], "  ", 
     "]"}]}], "   ", ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"PLOT", " ", "UNSTABLE", " ", "POINTS", " ", 
    RowBox[{"(", 
     RowBox[{"\[Alpha]", ",", "k"}], ")"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
