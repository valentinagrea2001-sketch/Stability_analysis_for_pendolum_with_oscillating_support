Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"XL", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", "k_"}], "}"}], "]"}], "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "v_", ",", "t_"}], "}"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{"v", ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "^", "2"}], " ", "-", " ", 
          RowBox[{"k", " ", 
           RowBox[{"Cos", "[", "t", "]"}]}]}], ")"}]}], " ", "x"}], " ", ",", 
      " ", "1"}], "}"}]}], " ", ";"}], "          ", 
  RowBox[{"(*", 
   RowBox[{
   "vector", " ", "field", " ", "of", " ", "variational", " ", "equation", 
    " ", "in", " ", "extended", " ", "phase", " ", "space"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"RK2", "[", 
      RowBox[{"ak_", ",", "h_"}], "]"}], "[", "xvt_", "]"}], ":=", 
    RowBox[{"xvt", " ", "+", " ", 
     RowBox[{"h", " ", 
      RowBox[{
       RowBox[{"XL", "[", "ak", "]"}], "[", 
       RowBox[{"xvt", "+", 
        RowBox[{
         FractionBox["h", "2"], 
         RowBox[{
          RowBox[{"XL", "[", "ak", "]"}], "[", "xvt", "]"}]}]}], "]"}]}]}]}], 
   ";"}], "   ", "         ", 
  RowBox[{"(*", 
   RowBox[{
   "RK2", " ", "to", " ", "approximate", " ", "solutions", " ", "of", " ", 
    "the", " ", "variational", " ", "equation"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sol", "[", 
     RowBox[{"ak_", ",", "n_", ",", 
      RowBox[{"{", 
       RowBox[{"x0_", ",", "v0_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{"Nest", "[", 
       RowBox[{
        RowBox[{"RK2", "[", 
         RowBox[{"ak", ",", 
          FractionBox[
           RowBox[{"2", "\[Pi]"}], "n"]}], " ", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x0", ",", "v0", ",", "0"}], "}"}], ",", " ", "n"}], "]"}], 
      ",", "2"}], "]"}]}], ";"}], "      ", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "compute", " ", "solution", " ", "of", " ", "variational", " ", 
     "equation"}], ",", " ", 
    RowBox[{"given", " ", "initial", " ", "data", " ", 
     RowBox[{"{", 
      RowBox[{"x0", ",", "v0"}], "}"}]}], ",", " ", 
    RowBox[{
     RowBox[{"at", " ", "time", " ", "T"}], "=", 
     RowBox[{"2", "\[Pi]"}]}], ",", " ", 
    RowBox[{"n", " ", "iterations"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"output", " ", "just", " ", 
    RowBox[{"(", 
     RowBox[{"x", ",", "v"}], ")"}], " ", "first", " ", "two", " ", 
    "entries"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PSM", "[", 
     RowBox[{"ak_", ",", "n_"}], "]"}], ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sol", "[", 
       RowBox[{"ak", ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "]"}], " ", ",", " ", 
      RowBox[{"sol", "[", 
       RowBox[{"ak", ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}]}], ";"}], 
  "             ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Period", " ", "Shift", " ", "Map"}], " ", "=", " ", 
     RowBox[{"Pointcar\[EAcute]", " ", "Map"}]}], ",", " ", 
    RowBox[{"given", " ", "initial", " ", "conditions", " ", 
     RowBox[{"(", 
      RowBox[{"1", ",", "0"}], ")"}]}], ",", " ", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9648718045587044`*^9, 3.964871805476013*^9}, {
   3.964871969981392*^9, 3.964872359336775*^9}, 3.964872822495537*^9, {
   3.964872972827959*^9, 3.9648729736942368`*^9}, {3.964882473031025*^9, 
   3.964882483322729*^9}, {3.969097127767599*^9, 3.96909713056752*^9}, {
   3.9693338713552227`*^9, 
   3.969333875419758*^9}},ExpressionUUID->"a139bbbd-5b09-8745-b494-\
9142ee29d513"],

