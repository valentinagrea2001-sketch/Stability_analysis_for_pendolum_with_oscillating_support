Cell[CellGroupData[{
Cell[TextData[{
 "Dynamical System: the pendolum with oscillating suspension ",
 Cell[BoxData[
  FormBox["point", TraditionalForm]],ExpressionUUID->
  "583b602f-07ab-6b42-ac6c-16b22246b289"]
}], "Title",
 CellChangeTimes->{{3.9648656712579536`*^9, 3.9648657151679688`*^9}, {
  4.001329601617611*^9, 
  4.001329614586321*^9}},ExpressionUUID->"175468bb-22ba-ad47-8a9a-\
ce961dfa5973"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["Assignment",
    FontWeight->"Bold"], 
   StyleBox[":",
    FontWeight->"Bold"], 
   StyleBox["\[IndentingNewLine]",
    FontWeight->"Bold"], 
   RowBox[{
   "For", " ", "the", " ", "period", " ", "shift", " ", "map", " ", "of", " ",
     "the", " ", 
    StyleBox["pendulum",
     FontVariations->{"Underline"->True}], 
    StyleBox[" ",
     FontVariations->{"Underline"->True}], 
    StyleBox["with",
     FontVariations->{"Underline"->True}], 
    StyleBox[" ",
     FontVariations->{"Underline"->True}], 
    StyleBox["oscillating",
     FontVariations->{"Underline"->True}], 
    StyleBox[" ",
     FontVariations->{"Underline"->True}], 
    StyleBox["suspension",
     FontVariations->{"Underline"->True}], 
    StyleBox[" ",
     FontVariations->{"Underline"->True}], 
    StyleBox["point",
     FontVariations->{"Underline"->True}], 
    StyleBox[" ",
     FontVariations->{"Underline"->True}], "in", " ", "the", " ", "parameter",
     " ", "space", " ", 
    RowBox[{"(", 
     RowBox[{"\[Alpha]", ",", "k"}], ")"}]}], ":", "\[IndentingNewLine]", 
   "          ", 
   RowBox[{
    RowBox[{
     StyleBox["a",
      FontWeight->"Bold"], 
     StyleBox[".",
      FontWeight->"Bold"], 
     StyleBox[" ",
      FontWeight->"Bold"], "plot"}], " ", "the", " ", "first", " ", "few", 
    " ", "instability", " ", "tongues", " ", "of", " ", "the", " ", "lower", 
    " ", "fixed", " ", "point", " ", "z_"}]}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0", ",", "0"}], ")"}], ".", "\[IndentingNewLine]", "     ", 
     StyleBox["b",
      FontWeight->"Bold"], 
     StyleBox[".",
      FontWeight->"Bold"], 
     StyleBox[" ",
      FontWeight->"Bold"], "plot"}], " ", "the", " ", "stability", " ", 
    "region", " ", 
    RowBox[{"(", 
     RowBox[{"regions", "?"}], ")"}], " ", "of", " ", "the", " ", "upper", 
    " ", "fixed", " ", "point", 
    FormBox[
     SubscriptBox["z", "+"],
     TraditionalForm]}], " ", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Pi]", ",", "0"}], ")"}], ".", 
    "\[IndentingNewLine]"}]}]}]], "Text",
 CellChangeTimes->{{3.964865719166273*^9, 3.9648657749584312`*^9}, {
  3.964865922820755*^9, 3.964865960858494*^9}, {3.9648660204308987`*^9, 
  3.9648660328559017`*^9}, {3.964880952521837*^9, 3.964880982008465*^9}, {
  3.9648824353749313`*^9, 3.9648824466043873`*^9}, {3.9666690441129246`*^9, 
  3.9666690525074806`*^9}, {4.00132963198987*^9, 
  4.0013297198592567`*^9}},ExpressionUUID->"54e1d230-7a8e-8f4f-8423-\
975e797cb517"],

Cell[TextData[{
 StyleBox["THE MODEL:",
  FontWeight->"Bold",
  FontVariations->{"Underline"->True}],
 "\n\nConsider a pendolum with oscillating suspension point 2Pi-periodically. \
\n\nAfter time rescaling the ",
 StyleBox["equation of motion",
  FontVariations->{"Underline"->True}],
 " is:      \n     x\[CloseCurlyQuote]\[CloseCurlyQuote]=-(\[Alpha]^2 - k \
Cos[t]) Sin[x]     with initial conditions  x(0)=x0,  \
x\[CloseCurlyQuote](0)=v0 ,\n where k=a/l <=2 .\n\nIn the ",
 StyleBox["phase space",
  FontVariations->{"Underline"->True}],
 " the equation of motion becomes a system of ODEs:\n     \
x\[CloseCurlyQuote]=v\n     v\[CloseCurlyQuote]=-(\[Alpha]^2 - k Cos[t]) \
Sin[x]            where (x,v) \\in S^1 x R .\nPoints (0,0) and (Pi,0) are the \
equilibria.\n\nBut the suspension point oscillates 2Pi-periodically in time, \
due to the external force which is 2Pi-periodic, hence it results more \
convenient to work in the Quotient Extended Phase Space where the orbits \
traced by the equilibria are given by  t-->(0,0,t Mod .2Pi)  , t--->(Pi,0,t \
Mod .2Pi)  .\nThe equation of motion in the ",
 StyleBox["Quotient Extended Phase Space",
  FontVariations->{"Underline"->True}],
 "  S^1 x R x S^1 becomes: \n    x\[CloseCurlyQuote]=v\n    v\
\[CloseCurlyQuote]=-(\[Alpha]^2 - k Cos[t]) Sin[x] \n    \
t\[CloseCurlyQuote]=1   mod 2Pi  .\n    \nFrom the theory, orbits ",
 StyleBox[" correspond to fixed points of the Pointcar\[EAcute] Map ",
  FontVariations->{"Underline"->True}],
 Cell[BoxData[
  SubscriptBox["\[Psi]", 
   RowBox[{"\[Alpha]", ",", "k"}]]],
  InitializationCell->True,
  CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQAmIQ/eLc3RWJXW8dj8TvXQWiLWadFk0C0nOmLNYG0Q2z
VumD6AUbo+xA9IGTHC4gesWm9gQQnWApVAqiOaYId4PoihfrFoLogF+Nq0D0
jZNr1oFom67OQyBap0nxONicv76XwebOW3QdRF/5++8jiE7ZdfgbiM55eeMn
iF7j6dCfAqQ/fHEF0ymzs+eDaJ1K+8Vg8fPrb4Foh683b4Noj2Db9lVAWkH7
aQ+IfiHyeQKIfvJIYimINnGqWwmiHTLNN4LoFTKKO0F0RVTgGRAdEXviNoj2
US+/AzZn2RvR1aBw6JSQANEZ+0OVQPSEj/HKIPrJn1XhIDpg+X4wfUS4egqI
rpEwXgmi13CmZF7ofesoYrczC0RbzHPuugikp/Ap9oDoPQbPJoFoHaUfM0H0
k9+XF4JoGynGRSAaAF1v5Sg=
   "],
  FontVariations->{"Underline"->True},ExpressionUUID->
  "3d00b722-5a45-c24d-a717-b2d331cab7b8"],
 StyleBox[" which is actually the Period Shift Map",
  FontVariations->{"Underline"->True}],
 " : ",
 Cell[BoxData[
  RowBox[{" ", 
   RowBox[{
    SubscriptBox["\[Psi]", 
     RowBox[{"\[Alpha]", ",", "k", "  "}]], "=", " ", 
    SubscriptBox["\[Phi]", 
     RowBox[{
      RowBox[{"2", "\[Pi]"}], ",", "0"}]]}]}]],
  InitializationCell->True,
  CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQAmIQ/eLc3RWJXW8dj8TvXQWiLWadFk0C0nOmLNYG0Q2z
VumD6AUbo+xA9IGTHC4gesWm9gQQnWApVAqiOaYId4PoihfrFoLogF+Nq0D0
jZNr1oFom67OQyBap0nxONicv76XwebOW3QdRF/5++8jiE7ZdfgbiM55eeMn
iF7j6dCfAqQ/fHEF0ymzs+eDaJ1K+8Vg8fPrb4Foh683b4Noj2Db9lVAWkH7
aQ+IfiHyeQKIfvJIYimINnGqWwmiHTLNN4LoFTKKO0F0RVTgGRAdEXviNoj2
US+/AzZn2RvR1aBw6JSQANEZ+0OVQPSEj/HKIPrJn1XhIDpg+X4wfUS4egqI
rpEwXgmi13CmZF7ofesoYrczC0RbzHPuugikp/Ap9oDoPQbPJoFoHaUfM0H0
k9+XF4JoGynGRSAaAF1v5Sg=
   "],ExpressionUUID->"97b815b4-f5dc-cf4a-95b0-e4b49fba50e8"],
 "  .\n\nWe need to linearize the Period Shift Map at fixed points, but from \
the theory its eigenvalues are those of the monodromy matrix without 1. \nThe \
monodromy matrix can be computed by solving the variational equation at time \
T=2Pi, with initial condition ",
 StyleBox["Id ",
  FontSlant->"Italic"],
 "matrix."
}], "Text",
 CellChangeTimes->{{3.9666680578445663`*^9, 3.9666681342789593`*^9}, {
   3.9666681797576885`*^9, 3.9666686523896294`*^9}, {3.9666687203103924`*^9, 
   3.9666688154609623`*^9}, 3.9666688613176785`*^9, {3.9666688918818855`*^9, 
   3.9666688976751957`*^9}, {3.9666689479322205`*^9, 
   3.9666689508338337`*^9}, {3.966669089703207*^9, 3.9666690912035484`*^9}, {
   3.96699251873048*^9, 3.966992523790579*^9}, {3.9690965575801353`*^9, 
   3.9690965686802254`*^9}, {3.9690966430492344`*^9, 
   3.9690966929637146`*^9}, {3.969101062846388*^9, 3.969101079255348*^9}, {
   3.9693337153816223`*^9, 3.969333756667164*^9}, {3.9705626205924263`*^9, 
   3.970562636240076*^9}, {4.001329731473068*^9, 4.00132974075828*^9}, {
   4.001329774619768*^9, 
   4.00132980481085*^9}},ExpressionUUID->"af7d710e-ad02-9946-90d2-\
fc0bdcf4f729"],

Cell["\<\
I have :
1) computed aside the Variational Equation for both the orbits t-->(0,0,t)  \
and t-->(Pi,0,t)  of the equilibria;
2) integrated the VE equation in both cases with Runge Kutta 2;
3) performed the analysis of the stability/instability regions in \
(\[Alpha],k).\
\>", "Text",
 CellChangeTimes->{{3.966668952314247*^9, 3.9666689817847157`*^9}, {
  3.966669022552799*^9, 3.96666902519314*^9}, {3.9690967620947037`*^9, 
  3.9690967732591*^9}, {4.0013298306407127`*^9, 
  4.0013298642206364`*^9}},ExpressionUUID->"3c9f1c93-3ffd-ec4b-b6f7-\
eafb8f20ab4d"],

Cell[CellGroupData[{

Cell["Stability/Unstability regions for (0,0) fixed point:", "Section",
 CellChangeTimes->{{3.9648724490572968`*^9, 3.964872474768135*^9}, {
  3.96488101506476*^9, 
  3.9648810163465385`*^9}},ExpressionUUID->"12250f8c-2f0d-6748-bab8-\
36ee1d4471d5"],

Cell[TextData[StyleBox["SETUP :",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.964872364025381*^9, 3.9648723746725864`*^9}, 
   3.9648724168104305`*^9, {3.964881596458084*^9, 
   3.964881598344242*^9}},ExpressionUUID->"482be205-5096-e245-875e-\
1f432f0b6aa5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"XL", "[", 
      RowBox[{"{", 
       RowBox[{"a_", ",", "k_"}], "}"}], "]"}], "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "v_", ",", "t_"}], "}"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{"v", ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "^", "2"}], " ", "-", " ", 
          RowBox[{"k", " ", 
           RowBox[{"Cos", "[", "t", "]"}]}]}], ")"}]}], " ", "x"}], " ", ",", 
      " ", "1"}], "}"}]}], " ", ";"}], "          ", 
  RowBox[{"(*", 
   RowBox[{
   "vector", " ", "field", " ", "of", " ", "variational", " ", "equation", 
    " ", "in", " ", "extended", " ", "phase", " ", "space"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"RK2", "[", 
      RowBox[{"ak_", ",", "h_"}], "]"}], "[", "xvt_", "]"}], ":=", 
    RowBox[{"xvt", " ", "+", " ", 
     RowBox[{"h", " ", 
      RowBox[{
       RowBox[{"XL", "[", "ak", "]"}], "[", 
       RowBox[{"xvt", "+", 
        RowBox[{
         FractionBox["h", "2"], 
         RowBox[{
          RowBox[{"XL", "[", "ak", "]"}], "[", "xvt", "]"}]}]}], "]"}]}]}]}], 
   ";"}], "   ", "         ", 
  RowBox[{"(*", 
   RowBox[{
   "RK2", " ", "to", " ", "approximate", " ", "solutions", " ", "of", " ", 
    "the", " ", "variational", " ", "equation"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sol", "[", 
     RowBox[{"ak_", ",", "n_", ",", 
      RowBox[{"{", 
       RowBox[{"x0_", ",", "v0_"}], "}"}]}], "]"}], ":=", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{"Nest", "[", 
       RowBox[{
        RowBox[{"RK2", "[", 
         RowBox[{"ak", ",", 
          FractionBox[
           RowBox[{"2", "\[Pi]"}], "n"]}], " ", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x0", ",", "v0", ",", "0"}], "}"}], ",", " ", "n"}], "]"}], 
      ",", "2"}], "]"}]}], ";"}], "      ", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "compute", " ", "solution", " ", "of", " ", "variational", " ", 
     "equation"}], ",", " ", 
    RowBox[{"given", " ", "initial", " ", "data", " ", 
     RowBox[{"{", 
      RowBox[{"x0", ",", "v0"}], "}"}]}], ",", " ", 
    RowBox[{
     RowBox[{"at", " ", "time", " ", "T"}], "=", 
     RowBox[{"2", "\[Pi]"}]}], ",", " ", 
    RowBox[{"n", " ", "iterations"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"output", " ", "just", " ", 
    RowBox[{"(", 
     RowBox[{"x", ",", "v"}], ")"}], " ", "first", " ", "two", " ", 
    "entries"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PSM", "[", 
     RowBox[{"ak_", ",", "n_"}], "]"}], ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sol", "[", 
       RowBox[{"ak", ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "]"}], " ", ",", " ", 
      RowBox[{"sol", "[", 
       RowBox[{"ak", ",", "n", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], "}"}]}], ";"}], 
  "             ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Period", " ", "Shift", " ", "Map"}], " ", "=", " ", 
     RowBox[{"Pointcar\[EAcute]", " ", "Map"}]}], ",", " ", 
    RowBox[{"given", " ", "initial", " ", "conditions", " ", 
     RowBox[{"(", 
      RowBox[{"1", ",", "0"}], ")"}]}], ",", " ", 
    RowBox[{"(", 
     RowBox[{"0", ",", "1"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9648718045587044`*^9, 3.964871805476013*^9}, {
   3.964871969981392*^9, 3.964872359336775*^9}, 3.964872822495537*^9, {
   3.964872972827959*^9, 3.9648729736942368`*^9}, {3.964882473031025*^9, 
   3.964882483322729*^9}, {3.969097127767599*^9, 3.96909713056752*^9}, {
   3.9693338713552227`*^9, 3.969333875419758*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"a139bbbd-5b09-8745-b494-9142ee29d513"],

Cell[TextData[StyleBox["USE COMPILE FOR SETUP, IN ORDER TO HAVE FASTER \
